---
import housing from "../../data/housing-pension-2026-03-01.json";
import { formulaMeta } from "../../lib/formulas";

interface Props {
  preset: "pension-timing" | "severance" | "health" | "housing" | "living-gap" | "pension-credit" | "card-deduction" | "deposit";
}
const { preset } = Astro.props;
const meta = formulaMeta[preset];
const ages = housing.ages.join(",");
const prices = housing.pricesWon.join(",");
---
<section class="calc" data-preset={preset} data-ages={ages} data-prices={prices} data-base={meta.baseDate}>
  <p>{meta.oneLiner}</p>
  <p>칸의 시작 숫자는 예시입니다.</p>
  {preset === "pension-timing" && (
    <>
      <label class="calc-field">월 금액
        <input inputmode="numeric" data-input="monthly" value="1000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="monthly" data-step="-100000">−</button>
        <output data-show="monthly">100만 원</output>
        <button type="button" data-field="monthly" data-step="100000">+</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-months="12" aria-pressed="true">12개월</button>
        <button type="button" class="choice" data-months="24">24개월</button>
        <button type="button" class="choice" data-months="60">60개월</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-direction="early" aria-pressed="true">일찍</button>
        <button type="button" class="choice" data-direction="defer">미루기</button>
      </div>
    </>
  )}
  {preset === "severance" && (
    <>
      <label class="calc-field">퇴직소득
        <input inputmode="numeric" data-input="income" value="100000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="income" data-step="-10000000">−</button>
        <output data-show="income">1억 원</output>
        <button type="button" data-field="income" data-step="10000000">+</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-years="10">10년</button>
        <button type="button" class="choice" data-years="20" aria-pressed="true">20년</button>
        <button type="button" class="choice" data-years="30">30년</button>
      </div>
    </>
  )}
  {preset === "health" && (
    <label class="calc-field">연 소득
      <input inputmode="numeric" data-input="annual" value="12000000" />
    </label>
    <div class="stepper">
      <button type="button" data-field="annual" data-step="-1000000">−</button>
      <output data-show="annual">1,200만 원</output>
      <button type="button" data-field="annual" data-step="1000000">+</button>
    </div>
  )}
  {preset === "housing" && (
    <>
      <div class="choice-row" data-age-row>
        {housing.ages.map((age) => (
          <button type="button" class="choice" data-age={age} aria-pressed={age === 70 ? "true" : "false"}>{age}세</button>
        ))}
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-price="300000000" aria-pressed="true">3억 원</button>
        <button type="button" class="choice" data-price="600000000">6억 원</button>
        <button type="button" class="choice" data-price="1200000000">12억 원</button>
      </div>
    </>
  )}
  {preset === "living-gap" && (
    <div class="stepper">
      <button type="button" data-field="spend" data-step="-100000">−</button>
      <output data-show="spend">생활비 250만 원</output>
      <button type="button" data-field="spend" data-step="100000">+</button>
    </div>
  )}
  {preset === "pension-credit" && (
    <>
      <label class="calc-field">연금저축 납입액
        <input inputmode="numeric" data-input="savings" value="2000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="savings" data-step="-100000">−</button>
        <output data-show="savings">200만 원</output>
        <button type="button" data-field="savings" data-step="100000">+</button>
      </div>
      <label class="calc-field">IRP 납입액
        <input inputmode="numeric" data-input="irp" value="0" />
      </label>
      <div class="stepper">
        <button type="button" data-field="irp" data-step="-100000">−</button>
        <output data-show="irp">0원</output>
        <button type="button" data-field="irp" data-step="100000">+</button>
      </div>
      <label class="calc-field">총급여
        <input inputmode="numeric" data-input="salary" value="50000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="salary" data-step="-1000000">−</button>
        <output data-show="salary">5,000만 원</output>
        <button type="button" data-field="salary" data-step="1000000">+</button>
      </div>
    </>
  )}
  {preset === "card-deduction" && (
    <>
      <label class="calc-field">총급여
        <input inputmode="numeric" data-input="salary" value="50000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="salary" data-step="-1000000">−</button>
        <output data-show="salary">5,000만 원</output>
        <button type="button" data-field="salary" data-step="1000000">+</button>
      </div>
      <label class="calc-field">신용카드 사용액
        <input inputmode="numeric" data-input="credit" value="15000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="credit" data-step="-1000000">−</button>
        <output data-show="credit">1,500만 원</output>
        <button type="button" data-field="credit" data-step="1000000">+</button>
      </div>
      <label class="calc-field">체크카드·현금영수증 사용액
        <input inputmode="numeric" data-input="debit" value="0" />
      </label>
      <div class="stepper">
        <button type="button" data-field="debit" data-step="-1000000">−</button>
        <output data-show="debit">0원</output>
        <button type="button" data-field="debit" data-step="1000000">+</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-children="0" aria-pressed="true">자녀 없음</button>
        <button type="button" class="choice" data-children="1">자녀 1명</button>
        <button type="button" class="choice" data-children="2">자녀 2명 이상</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-rate="6">6%</button>
        <button type="button" class="choice" data-rate="15" aria-pressed="true">15%</button>
        <button type="button" class="choice" data-rate="24">24%</button>
        <button type="button" class="choice" data-rate="35">35%</button>
      </div>
    </>
  )}
  {preset === "deposit" && (
    <>
      <label class="calc-field">원금
        <input inputmode="numeric" data-input="principal" value="100000000" />
      </label>
      <div class="stepper">
        <button type="button" data-field="principal" data-step="-10000000">−</button>
        <output data-show="principal">1억 원</output>
        <button type="button" data-field="principal" data-step="10000000">+</button>
      </div>
      <div class="stepper">
        <button type="button" data-field="rateTenth" data-step="-1">−</button>
        <output data-show="rateTenth">금리 1.0%</output>
        <button type="button" data-field="rateTenth" data-step="1">+</button>
      </div>
      <div class="choice-row">
        <button type="button" class="choice" data-months="6">6개월</button>
        <button type="button" class="choice" data-months="12" aria-pressed="true">12개월</button>
        <button type="button" class="choice" data-months="24">24개월</button>
      </div>
    </>
  )}
  <p class="calc-result" data-result></p>
  <p>{meta.meaning}</p>
</section>
<script>
  import { cardDeduction, depositInterest, healthPremium, housingPension, livingGap, pensionCredit, pensionTiming, plainMoney, severanceTax } from "../../lib/formulas";

  const money = (value: number) => plainMoney(value);

  document.querySelectorAll(".calc").forEach((box) => {
    const preset = box.getAttribute("data-preset");
    const state = {
      monthly: 1_000_000,
      months: 12,
      direction: "early" as "early" | "defer",
      income: 100_000_000,
      years: 20,
      annual: 12_000_000,
      age: 70,
      price: 300_000_000,
      spend: 2_500_000,
      savings: 2_000_000,
      irp: 0,
      salary: 50_000_000,
      credit: 15_000_000,
      debit: 0,
      children: 0,
      taxRate: 15,
      principal: 100_000_000,
      rateTenth: 10,
    };
    type MoneyKey = "monthly" | "income" | "annual" | "spend" | "savings" | "irp" | "salary" | "credit" | "debit" | "principal" | "rateTenth";
    const result = box.querySelector("[data-result]");
    const paint = () => {
      box.querySelectorAll<HTMLInputElement>("[data-input]").forEach((input) => {
        const key = input.dataset.input as MoneyKey | undefined;
        if (!key || document.activeElement === input) return;
        input.value = String(state[key]);
      });
      box.querySelectorAll("[data-show]").forEach((node) => {
        const key = node.getAttribute("data-show");
        if (key === "monthly") node.textContent = money(state.monthly);
        if (key === "income") node.textContent = money(state.income);
        if (key === "annual") node.textContent = money(state.annual);
        if (key === "spend") node.textContent = `생활비 ${money(state.spend)}`;
        if (key === "savings") node.textContent = money(state.savings);
        if (key === "irp") node.textContent = money(state.irp);
        if (key === "salary") node.textContent = money(state.salary);
        if (key === "credit") node.textContent = money(state.credit);
        if (key === "debit") node.textContent = money(state.debit);
        if (key === "principal") node.textContent = money(state.principal);
        if (key === "rateTenth") node.textContent = `금리 ${(state.rateTenth / 10).toFixed(1)}%`;
      });
      if (!result) return;
      if (preset === "pension-timing") result.textContent = pensionTiming(state).sentence;
      if (preset === "severance") result.textContent = severanceTax(state).sentence;
      if (preset === "health") result.textContent = healthPremium({ annualIncome: state.annual, propertyScore: 0 }).sentence;
      if (preset === "housing") result.textContent = housingPension({ age: state.age, priceWon: state.price }).sentence;
      if (preset === "living-gap") {
        result.textContent = livingGap({
          spend: state.spend,
          pension: 1_000_000,
          basic: 0,
          personal: 300_000,
          other: 0,
        }).sentence;
      }
      if (preset === "pension-credit") {
        result.textContent = pensionCredit({
          savings: state.savings,
          irp: state.irp,
          salary: state.salary,
        }).sentence;
      }
      if (preset === "card-deduction") {
        result.textContent = cardDeduction({
          salary: state.salary,
          credit: state.credit,
          debit: state.debit,
          children: state.children,
          taxRatePercent: state.taxRate,
        }).sentence;
      }
      if (preset === "deposit") {
        result.textContent = depositInterest({
          principal: state.principal,
          rateTenth: state.rateTenth,
          months: state.months,
        }).sentence;
      }
    };
    box.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      const field = target.dataset.input;
      if (!field || !(field in state)) return;
      const key = field as MoneyKey;
      state[key] = Math.max(0, Number(String(target.value).replace(/[^\d]/g, "")) || 0);
      paint();
    });
    box.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const step = target.dataset.step;
      const field = target.dataset.field;
      if (step && field && field in state) {
        const key = field as MoneyKey;
        state[key] = Math.max(0, state[key] + Number(step));
      }
      if (target.dataset.months) {
        state.months = Number(target.dataset.months);
        box.querySelectorAll("[data-months]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.direction === "early" || target.dataset.direction === "defer") {
        state.direction = target.dataset.direction;
        box.querySelectorAll("[data-direction]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.years) {
        state.years = Number(target.dataset.years);
        box.querySelectorAll("[data-years]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.age) {
        state.age = Number(target.dataset.age);
        box.querySelectorAll("[data-age]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.price) {
        state.price = Number(target.dataset.price);
        box.querySelectorAll("[data-price]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.children) {
        state.children = Number(target.dataset.children);
        box.querySelectorAll("[data-children]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      if (target.dataset.rate) {
        state.taxRate = Number(target.dataset.rate);
        box.querySelectorAll("[data-rate]").forEach((button) => button.setAttribute("aria-pressed", "false"));
        target.setAttribute("aria-pressed", "true");
      }
      paint();
    });
    paint();
  });
</script>
