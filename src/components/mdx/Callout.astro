---
interface Props { type?: "summary" | "warn" | "tip" | "example"; title?: string; }
const labels = { summary: "핵심 요약", warn: "주의", tip: "팁", example: "예시 계산" };
const { type = "summary", title } = Astro.props;
---
<aside class={`callout callout-${type}`}>
  <p class="callout-label">
    <span class="callout-icon" aria-hidden="true">
      {type === "summary" && (
        <svg viewBox="0 0 24 24"><path d="M5 12.5 9.2 17 19 7" /></svg>
      )}
      {type === "warn" && (
        <svg viewBox="0 0 24 24"><path d="M12 4.2 21.2 20H2.8L12 4.2Z" /><path d="M12 10v4.2" /><path d="M12 16.9h.01" /></svg>
      )}
      {type === "tip" && (
        <svg viewBox="0 0 24 24"><path d="M9 18h6" /><path d="M10 21h4" /><path d="M12 3a6 6 0 0 0-3.2 11.1c.4.4.7.9.7 1.5V17h5v-1.4c0-.6.3-1.1.7-1.5A6 6 0 0 0 12 3Z" /></svg>
      )}
      {type === "example" && (
        <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
      )}
    </span>
    {title ?? labels[type]}
  </p>
  <div class="callout-body"><slot /></div>
</aside>
