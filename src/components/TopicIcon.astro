---
interface Props {
  name: "landmark" | "receipt" | "heart" | "users" | "house" | "calendar";
}
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === "landmark" && (
    <>
      <path d="M12 3 4 7.5h16L12 3z" />
      <path d="M6 10v7M10 10v7M14 10v7M18 10v7" />
      <path d="M4 20h16" />
    </>
  )}
  {name === "receipt" && (
    <>
      <path d="M7 3h10a1 1 0 0 1 1 1v17l-2-1.2-2 1.2-2-1.2-2 1.2-2-1.2L6 21V4a1 1 0 0 1 1-1z" />
      <path d="M9 8h6M9 12h6M12 16v-8" />
    </>
  )}
  {name === "heart" && (
    <>
      <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" />
      <path d="M8 12h2l1.2-2 1.8 4 1.2-2H16" />
    </>
  )}
  {name === "users" && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19v-1.2A3.8 3.8 0 0 1 7.3 14h3.4a3.8 3.8 0 0 1 3.8 3.8V19" />
      <circle cx="17" cy="8.5" r="2.4" />
      <path d="M17.2 14.2a3.6 3.6 0 0 1 3.3 3.5V19" />
    </>
  )}
  {name === "house" && (
    <>
      <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5.2v-6.2H10.2V21H5a1 1 0 0 1-1-1z" />
    </>
  )}
  {name === "calendar" && (
    <>
      <rect x="4" y="5" width="16" height="15" rx="2" />
      <path d="M8 3.5V7M16 3.5V7M4 10h16" />
    </>
  )}
</svg>
