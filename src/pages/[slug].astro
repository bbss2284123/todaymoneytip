---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import AtAGlance from "../components/mdx/AtAGlance.astro";
import Term from "../components/mdx/Term.astro";
import EligibilityChecklist from "../components/mdx/EligibilityChecklist.astro";
import WorkedExample from "../components/mdx/WorkedExample.astro";
import Calculator from "../components/mdx/Calculator.astro";
import ApplyBox from "../components/mdx/ApplyBox.astro";
import AdSlot from "../components/mdx/AdSlot.astro";
import Figure from "../components/mdx/Figure.astro";
import { siteConfig, categoryById, absoluteUrl } from "../../site.config";
import { allPublished, authorName, postPath, readingMinutes, relatedPosts, seriesMates } from "../lib/posts";
import { formatKo, isPastDate, seoulToday } from "../lib/dates";

export async function getStaticPaths() {
  const posts = await allPublished();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const posts = await allPublished();
const { Content } = await render(post);
const category = categoryById(post.data.category);
const related = relatedPosts(post, posts);
const series = seriesMates(post, posts);
const closed = post.data.status === "마감" || (post.data.applyPeriod ? isPastDate(post.data.applyPeriod.end, seoulToday()) : false);
const minutes = readingMinutes(post.body ?? "");
const url = absoluteUrl(postPath(post.id));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.updated,
    author: { "@type": "Person", name: siteConfig.author.name },
    publisher: { "@type": "Organization", name: siteConfig.name, url: siteConfig.url },
    mainEntityOfPage: url,
    image: absoluteUrl(`/thumb/${post.id}/discover.png`),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: siteConfig.url },
      { "@type": "ListItem", position: 2, name: category?.name, item: absoluteUrl(`/category/${post.data.category}/`) },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
  ...(post.data.faq?.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: post.data.faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }]
    : []),
];
---
<Base
  title={post.data.serpTitle}
  description={post.data.description}
  path={postPath(post.id)}
  ogImage={`/thumb/${post.id}/og.png`}
  type="article"
  published={post.data.date}
  modified={post.data.updated}
  jsonLd={jsonLd}
>
  <article id="content" class="article" data-pagefind-body>
    <nav class="crumbs" aria-label="경로">
      <a href="/">홈</a>
      <span>/</span>
      <a href={`/category/${post.data.category}/`}>{category?.name}</a>
    </nav>
    <h1>{post.data.title}</h1>
    <p class="dates">
      {post.data.baseDate && <>기준일 {formatKo(post.data.baseDate)}. </>}
      수정일 {formatKo(post.data.updated)}. 읽는 시간 {minutes}분. {authorName(post)}
    </p>
    {closed && (
      <p class="answer-box">
        이 안내의 신청 기간은 지났거나 마감이에요.
        {post.data.closedNote ? ` ${post.data.closedNote}` : ""}
        {post.data.nextRound && <a href={post.data.nextRound.url}>{post.data.nextRound.title}</a>}
      </p>
    )}
    <div class="prose">
      <Content components={{ AtAGlance, Term, EligibilityChecklist, WorkedExample, Calculator, ApplyBox, AdSlot, Figure }} />
    </div>
    {post.data.faq && (
      <section class="faq">
        <h2>자주 묻는 질문</h2>
        {post.data.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}
    <section class="author">
      <h2>{siteConfig.author.name}</h2>
      <p>{siteConfig.author.bio}</p>
      <p><a href="/author/">글쓴이 소개</a></p>
    </section>
    <section class="sources">
      <h2>출처</h2>
      <ul>
        {post.data.sources.map((source) => (
          <li><a href={source.url}>{source.title}</a></li>
        ))}
      </ul>
    </section>
    {series.length > 1 && (
      <nav class="sources" aria-label="시리즈">
        <h2>{post.data.series?.title}</h2>
        <ol>
          {series.map((item) => (
            <li>{item.id === post.id ? item.data.title : <a href={postPath(item.id)}>{item.data.title}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    {related.length > 0 && (
      <section>
        <h2>이어서 읽기</h2>
        <ul>
          {related.map((item) => (
            <li><a href={postPath(item.id)}>{item.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
