---
import "../styles/global.css";
import { siteConfig, categoriesInMenu, absoluteUrl } from "../../site.config";
import Seo from "../components/Seo.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: "website" | "article";
  jsonLd?: unknown[];
  published?: string;
  modified?: string;
}
const { title, description, path, ogImage, type = "website", jsonLd = [], published, modified } = Astro.props;
const canonical = absoluteUrl(path);
const here = Astro.url.pathname;
const primaryIds = new Set(
  siteConfig.primaryNav
    .map((item) => item.href.match(/^\/category\/([^/]+)\/$/)?.[1])
    .filter((id): id is string => Boolean(id)),
);
const moreCategories = categoriesInMenu().filter((category) => !primaryIds.has(category.id));

function isCurrent(href: string): boolean {
  if (href.includes("#")) return false;
  const target = href.endsWith("/") ? href : `${href}/`;
  return here === target || (target !== "/" && here.startsWith(target));
}
---
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="naver-site-verification" content="1f571632fc311810ae59774391eafa09db0a2529" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/pretendard/Pretendard-Regular.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pretendard/Pretendard-ExtraBold.subset.woff2" as="font" type="font/woff2" crossorigin />
    {type === "article" && <link rel="preload" href="/fonts/pretendard/Pretendard-Bold.subset.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      published={published}
      modified={modified}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <header class="site-header">
      <div class="header-bar">
        <div class="header-inner">
          <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">오</span><span class="logo-text">{siteConfig.logoText}</span></a>
          <nav id="site-menu" class="site-nav" aria-label="주요">
            {siteConfig.primaryNav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
            <div class="nav-more">
              <p class="nav-more-label">다른 주제</p>
              {moreCategories.map((category) => (
                <a href={`/category/${category.id}/`} aria-current={isCurrent(`/category/${category.id}/`) ? "page" : undefined}>{category.name}</a>
              ))}
              <a href="/roadmap/">퇴직 일정</a>
            </div>
          </nav>
          <div class="header-actions">
            <a class="icon-btn" href="/search/" aria-label="검색">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="M16 16.5 20 20.5"></path>
              </svg>
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
              <span class="menu-icon" aria-hidden="true"></span>
              <span class="menu-word">메뉴</span>
            </button>
          </div>
        </div>
      </div>
    </header>
    <script is:inline>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#site-menu");
      function setMenu(open) {
        if (!menuButton || !menu) return;
        menuButton.setAttribute("aria-expanded", String(open));
        menu.classList.toggle("is-open", open);
      }
      menuButton?.addEventListener("click", () => {
        setMenu(menuButton.getAttribute("aria-expanded") !== "true");
      });
      menu?.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a")) setMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });
      document.addEventListener("click", (event) => {
        if (!menu?.classList.contains("is-open")) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (menu.contains(target) || menuButton?.contains(target)) return;
        setMenu(false);
      });
    </script>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="logo footer-logo" href="/"><span class="logo-mark" aria-hidden="true">오</span><span class="logo-text">{siteConfig.name}</span></a>
        <p class="footer-desc">{siteConfig.description}</p>
        <nav class="footer-cats" aria-label="분류">
          {categoriesInMenu().map((category) => (
            <a href={`/category/${category.id}/`}>{category.name}</a>
          ))}
        </nav>
        <nav class="footer-meta" aria-label="안내">
          <a href="/about/">소개</a>
          <a href="/contact/">문의</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="footer-copy">© {new Date().getFullYear()} {siteConfig.url.replace("https://", "")}</p>
      </div>
    </footer>
  </body>
</html>
